# --- Excel / Office lock files -----------------------------------------------
# Created while a workbook is open. Never commit these.
~$*
*.tmp

# --- Temporary / scratch ------------------------------------------------------
_to_delete/
*_delete_me.*

# --- Python / Jupyter ---------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# --- Google Colab scratch -----------------------------------------------------
sample_data/
drive/

# --- Forecasting framework scratch --------------------------------------------
# AutoGluon writes fitted model artefacts here by default. They are large and
# regenerable - they must not reach the repository.
AutogluonModels/
ag_models/
**/AutogluonModels/

# --- Operating system ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Keep -------------------------------------------------------------------
# Code/experiments.csv, Code/common/*.yaml, Data/*.csv and Results/*.xlsx ARE
# tracked on purpose - the paper promises the work is reproducible.
# Do not add them here.
# If a results file ever approaches 100 MB, tell the team before committing;
# GitHub rejects files above that limit.

# --- fetch_data.py raw response cache ------------------------------------------
# Cached raw API/workbook payloads behind Data/*.csv, added separately from the
# tracked Data/*.csv outputs pending a decision on whether to commit raw payloads.
Data/raw/

# --- Phase 2 build scratch ------------------------------------------------------
# Manually-downloaded wheel files (pip's --extra-index-url resolver picked a CPU-only
# torch despite a CUDA index; these were fetched directly to install the right build)
# and pip/curl install logs. Multi-GB, fully regenerable, never committed.
.wheel_cache/
install_*.log
curl_*.log
p201_run*.log
pilot_samples.log
tab01_s1_monthly_run.log
Main_Experiment_Plan.xlsx.bak

# --- Results provenance ----------------------------------------------------------
# Results/*.xlsx is tracked on purpose (see above); the per-run JSON provenance next
# to it is small and also tracked - no entry needed here, listed for clarity only.

# --- Repository sync (2026-09-25) ------------------------------------------------
# Root-level logs only (install, curl and run logs); Results/Logs/ is a separate decision.
/*.log

# Intermediate workbook snapshots, superseded by the final Results/*.xlsx.
Results/Backups/

# Manual editing backups of the manuscript.
Paper/CBSL_research/main_BEFORE_*.tex

